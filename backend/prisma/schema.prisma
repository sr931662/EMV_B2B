// Prisma schema for the EMV B2B travel portal.
//
// Design constraints come from /PROJECT_SPEC.md (locked rules — do not violate):
//   1. Soft-delete everywhere. Every table carries `archived`; nothing is ever hard-deleted.
//      Every relation uses onDelete: Restrict so an accidental hard delete fails loudly
//      at the database level instead of silently cascading.
//   2. Library entries are COPIED into packages, never linked. PackageDay / PackageHotel
//      deliberately have NO foreign key back to DayTemplate / Hotel — they are frozen
//      snapshots taken at select-time. Same for VisaDocumentUpload.documentName, which is a
//      copied string rather than an FK to VisaRequiredDocument.
//   3. Payment unlocks BOOKING CONFIRMATION only. Both quote PDFs (Package.emvQuotePdfPath
//      and Quote.pdfPath) are generatable and downloadable with no Payment row present.
//      Payment only drives the transition into BOOKING_CONFIRMED.
//
// See /DATA_MODELS.md for a per-model description.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  admin
  data_feeder
  partner
}

enum Branding {
  EMV
  OWN
}

enum QuoteStatus {
  QUOTE_GENERATED
  CUSTOMER_APPROVED
  PAYMENT_SUBMITTED
  PENDING_VERIFICATION
  BOOKING_CONFIRMED
  ORDER_COMPLETED
  REJECTED
}

// Mirrors the adults/children/infants split already on Quote.
enum TravellerType {
  ADULT
  CHILD
  INFANT
}

enum PaymentType {
  PACKAGE
  VISA
}

enum PaymentStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  INFO_REQUESTED
}

enum VisaRequestStatus {
  APPLICATION_SUBMITTED
  PAYMENT_SUBMITTED
  PENDING_VERIFICATION
  PAYMENT_APPROVED
  VISA_PROCESSING_STARTED
  COMPLETED
  REJECTED
}

// How the finished visa reaches the partner. Drives VisaRequest.evisaDocumentPath: an E_VISA is
// delivered as a file the admin uploads, a REGULAR one is stamped in the physical passport.
// NOT the same axis as VisaCategory below — that is what the product IS, this is what we hand back.
enum VisaType {
  REGULAR
  E_VISA
}

// What kind of visa a product is. VISA_FREE and VISA_ON_ARRIVAL are informational: there is
// nothing to apply for, so visaRequestService refuses to create a request against them.
enum VisaCategory {
  VISA_FREE
  VISA_ON_ARRIVAL
  E_VISA
  STICKER_VISA
}

// Classifies a required document so the "documents required" filter can work on structure rather
// than on documentName, which is free text an admin types ("Bank Statement" vs "6-month bank
// statements" vs "Bank stmt") and could never be filtered reliably.
//
// The filter profile (only passport / passport + bank / + ITR / with prior visa) is DERIVED from
// the set of categories on a product, never stored alongside it. Storing it as its own column
// would let an admin edit the document list and forget the profile, and the filter would then
// quietly lie about what a product actually needs.
enum VisaDocumentCategory {
  PASSPORT
  BANK_STATEMENT
  INCOME_TAX_RETURN
  PRIOR_VISA // an existing US / UK / Schengen visa
  PHOTO
  OTHER
}

// How many times the holder may enter the country on one visa.
enum VisaEntryType {
  SINGLE
  MULTIPLE
}

// Consulates price children below the adult rate (and sometimes free), so the fee a request is
// worth depends on the MIX of passengers, not just how many there are.
enum PassengerType {
  ADULT
  CHILD
}

/**
 * What a scheduled item on an itinerary day IS.
 *
 * Typed rather than free text because the itinerary view renders each kind differently — a
 * transfer shows a vehicle and luggage allowance, a meal shows what is included, an overnight
 * shows nothing but a marker — and because "how many sightseeing slots does this package have"
 * is a question worth being able to ask.
 */
enum DayEventType {
  ARRIVAL
  CHECK_IN
  TRANSFER
  SIGHTSEEING
  ACTIVITY
  MEAL
  LEISURE
  CHECK_OUT
  OVERNIGHT
  DEPARTURE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum TransportMode {
  FLIGHT
  TRAIN
  BUS
  FERRY
  CAR
}


// How a cancellation charge is worked out. Three shapes because the industry genuinely uses three,
// and flattening them into "amount" loses which one was agreed.
enum CancellationChargeType {
  // A share of the trip value. The common case for land packages.
  PERCENT_OF_TOTAL
  // A flat sum, which is why a tier carries its own currency.
  FIXED_AMOUNT
  // "First night non-refundable" — a hotel charge expressed in nights, not money, so it stays
  // correct when the rate changes.
  NIGHTS
  // Nothing is charged. Stored explicitly rather than as 0 PERCENT so a free-cancellation window
  // reads as a decision rather than an unset value.
  NONE
}

// What a note block is for. Drives where it is offered, not how it renders — every one of these is
// markdown printed in a section of a document.
enum NoteBlockType {
  TERMS_AND_CONDITIONS
  SCOPE_OF_SERVICES
  CANCELLATION_POLICY_TEXT
  AMENDMENT_POLICY
  GENERAL_NOTE
  TOURS_AND_TRANSFERS_NOTE
  VISA_NOTE
  PAYMENT_TERMS
  OTHER
}

// Who has to produce a document. Decides whether the checklist asks once per booking or once per
// traveller — asking for four passports and one air ticket is the difference.
enum DocumentSubject {
  TRAVELLER
  BOOKING
}


// What a vendor supplies. One vendor may supply several things, which is why this is on the
// relationship where it matters rather than being a single label on the vendor.
enum VendorType {
  HOTEL_SUPPLIER
  DMC
  TRANSPORT
  ACTIVITY
  INSURANCE
  VISA
  OTHER
}

/// What a hotel rate is quoted against.
///
/// A number without this is not a price. "4500" is per room per night from one supplier and per
/// person per night from the next, and the difference for a family of four is threefold.
enum RateBasis {
  PER_ROOM_PER_NIGHT
  PER_PERSON_PER_NIGHT
  PER_ROOM_PER_STAY
  PER_PERSON_PER_STAY
}

/// Who the rate line covers. Room occupancy and child policy in one list because that is how
/// contracts are actually written — "child with bed" sits alongside "triple", not in another table.
enum Occupancy {
  SINGLE
  DOUBLE
  TRIPLE
  QUAD
  EXTRA_ADULT
  CHILD_WITH_BED
  CHILD_NO_BED
  INFANT
}

/// Who an activity rate covers.
enum PaxType {
  ADULT
  CHILD
  INFANT
  // A flat price for the whole group regardless of headcount — how private transfers are sold.
  GROUP
}

/// Seat-in-coach or private. The single biggest driver of an activity's price.
enum TransferBasis {
  SIC
  PRIVATE
  NONE
}

// ---------------------------------------------------------------------------
// Auth & identity
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role
  isVerified   Boolean   @default(false)
  otpCode      String?
  otpExpiresAt DateTime?

  // Session-revocation counter. Every JWT carries the tokenVersion it was minted with;
  // authMiddleware rejects a token whose value no longer matches this row. Incrementing it
  // invalidates every token issued before that instant (password reset, admin archive).
  tokenVersion Int @default(0)

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Populated only when role = partner.
  partnerProfile PartnerProfile?

  quotes           Quote[]
  visaRequests     VisaRequest[]
  notifications    Notification[]
  verifiedPayments Payment[]      @relation("PaymentVerifiedBy")

  @@index([role])
  @@index([archived])
}

model PartnerProfile {
  id     String @id @default(uuid())
  userId String @unique

  companyName   String
  companyLogo   String?
  ownerName     String
  gstNumber     String?
  panNumber     String?
  businessEmail String
  mobile        String
  officeAddress String
  city          String
  state         String
  country       String
  pincode       String
  website       String?

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([archived])
}

// ---------------------------------------------------------------------------
// Reference data / intern-maintained library
// ---------------------------------------------------------------------------


/**
 * A country, as a knowledge base rather than a name.
 *
 * PHASE 3, EXPAND STEP. Two problems this fixes:
 *
 *   1. `Destination` conflated country and city. "Dubai" and "United Arab Emirates" were the same
 *      kind of row, so a package could not say which city it visited inside which country.
 *   2. `VisaCountry` was a SECOND table for the same real-world thing, matched to Destination by
 *      comparing name strings. Spell one "UAE" and the other "United Arab Emirates" and the visa
 *      section silently went blank with no error anywhere.
 *
 * Country is now the single row for a country. VisaCountry still exists and still works — this
 * migration expands and backfills only. Contracting it away happens once every consumer reads
 * through Country, which is deliberately a later step: nothing is dropped in the same change that
 * adds its replacement.
 */
model Country {
  id String @id @default(uuid())

  name String @unique
  // ISO 3166-1. alpha2 is what flag CDNs and phone libraries key on; alpha3 is what airlines and
  // visa systems tend to use. Both, because converting between them at read time is a lookup table
  // nobody wants to own.
  isoAlpha2 String? @unique
  isoAlpha3 String? @unique
  dialCode  String?
  slug      String  @unique

  shortName    String?
  description  String? @db.Text
  flagImageUrl String?
  heroImageUrl String?

  // A country's default currency. Not a constraint on what a package may be priced in — that is the
  // package's own choice — but the sensible default when quoting locally.
  currencyCode String?

  languages String[]
  timeZones String[]

  emergencyContacts String? @db.Text
  embassyDetails    String? @db.Text
  weatherSummary    String? @db.Text
  // Month numbers 1-12. An array rather than a free-text season so "which countries are good in
  // March" is a query rather than a reading exercise.
  bestMonths        Int[]

  travelNotes String? @db.Text

  // Absorbed from VisaCountry at the contract step. Wholesale per-passenger visa fee, frozen into
  // VisaRequest.baseFeeAtRequest at the moment a request is created (copy-on-select, rule 2) — an
  // admin repricing a country must never move an existing request's numbers. A fallback only. What
  // a partner actually pays comes from the VisaProduct they pick.
  baseFee Decimal @default(0) @db.Decimal(12, 2)

  searchText String @default("")

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency     Currency?     @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  destinations Destination[]
  visaProducts VisaProduct[]
  visaRequests VisaRequest[]
  vendors      Vendor[]

  @@index([archived])
  @@index([currencyCode])
  // Declared here, not only in raw SQL, so Prisma stops planning a DROP for an index it
  // cannot see. A trigram index created outside the schema is invisible to drift detection
  // and gets removed by the next unrelated migration.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Country_searchText_trgm")
}

model Destination {
  id               String  @id @default(uuid())
  searchText       String  @default("")
  name             String  @unique
  aboutDestination String? @db.Text
  packages         String? @db.Text
  faqs             String? @db.Text

  // The country this destination sits inside. Nullable through the expand phase so existing rows
  // keep working while the backfill runs; made required once every writer sets it.
  countryId String?

  // City-level identity. A destination is Tokyo, not Japan.
  state     String?
  city      String?
  shortCode String?
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  timeZone  String?

  bestSeason     String?
  weatherSummary String? @db.Text

  // Future-ready, and cheap now: writing these columns later means a migration on a table that by
  // then has real traffic.
  seoTitle       String?
  seoDescription String? @db.Text
  seoKeywords    String[]

  // Presentation, mirroring Country so a destination card and a country card can look the same.
  shortName     String?
  coverImageUrl String?
  flagImageUrl  String?

  // "Country wise notes" on the voucher. Country-level because they describe the destination, so
  // every package sold there shows the same text rather than each one repeating it.
  generalNotes           String? @db.Text
  toursAndTransfersNotes String? @db.Text

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country      Country?      @relation(fields: [countryId], references: [id], onDelete: Restrict)
  activities   Activity[]
  dayTemplates DayTemplate[]
  hotels       Hotel[]
  // Named packageListings, not `packages`, because the intern-maintained `packages`
  // markdown blob above already owns that name on this model.
  packageListings Package[]
  holidayTypes    HolidayTypeOnDestination[]

  @@index([archived])
  @@index([countryId])
  // Declared here, not only in raw SQL, so Prisma stops planning a DROP for an index it
  // cannot see. A trigram index created outside the schema is invisible to drift detection
  // and gets removed by the next unrelated migration.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Destination_searchText_trgm")
}

/**
 * A reusable itinerary day.
 *
 * Carries the same content a PackageDay does, including its own schedule of events, so selecting a
 * template drops a fully-formed day into a package rather than a title and a paragraph the admin
 * then has to rebuild event by event.
 */
model DayTemplate {
  id            String @id @default(uuid())
  destinationId String
  title         String
  description   String @db.Text

  brief         String?    @db.Text
  notes         String?    @db.Text
  inclusions    String?    @db.Text
  coverImageUrl String?
  mealsIncluded MealType[]

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destination Destination        @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  events      DayTemplateEvent[]

  @@index([destinationId])
  @@index([archived])
}

/**
 * The schedule inside a reusable day — the library twin of PackageDayEvent.
 *
 * Same shape, including one level of sub-events, so a copy into a package is a field-for-field
 * translation with nothing lost.
 */
model DayTemplateEvent {
  id            String  @id @default(uuid())
  dayTemplateId String
  parentEventId String?
  // Phase 5: which library activity this event is. The title and description stay copied — locked
  // rule 2 — so an event already built keeps reading the way its author wrote it; the reference is
  // what makes the same activity countable and priceable across every template that uses it.
  activityId    String?

  sortOrder   Int
  title       String
  description String?      @db.Text
  type        DayEventType @default(ACTIVITY)

  // Minutes from midnight, not a timestamp — a template has no dates.
  startMinute     Int?
  durationMinutes Int?

  mealsIncluded MealType[]
  availability  String?

  transferMode     String?
  luggageAllowance String?

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dayTemplate DayTemplate        @relation(fields: [dayTemplateId], references: [id], onDelete: Restrict)
  parentEvent DayTemplateEvent?  @relation("TemplateSubEvents", fields: [parentEventId], references: [id], onDelete: Restrict)
  subEvents   DayTemplateEvent[] @relation("TemplateSubEvents")
  activity    Activity?          @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@index([dayTemplateId])
  @@index([parentEventId])
  @@index([activityId])
  @@index([archived])
}

/**
 * The intern-maintained hotel library.
 *
 * Every field a PackageHotel can hold lives here too, on purpose. This is the SOURCE that gets
 * copied into a package (locked rule 2), so anything missing here is something an admin has to
 * retype for every package the hotel appears in — which is exactly what a library exists to
 * prevent. Parity is the contract: add a field to PackageHotel and it belongs here as well.
 */
model Hotel {
  id            String   @id @default(uuid())
  destinationId String
  // Lower-cased haystack maintained on write; backs the trigram index the hotel picker searches.
  searchText    String   @default("")
  name          String
  category      String
  description   String   @db.Text
  images        String[]

  address       String? @db.Text
  coverImageUrl String?

  // Our own rating out of 5, distinct from the Google numbers below, which are someone else's
  // measurement and are shown as such.
  starRating        Int?
  mapLink           String?
  googleRating      Decimal? @db.Decimal(2, 1)
  googleRatingCount Int?

  // Times of day in minutes from midnight. The DATE a guest checks in comes from the trip, never
  // from here — see PackageHotel for the same reasoning.
  checkInMinute  Int?
  checkOutMinute Int?

  // Defaults offered when this hotel is put into a package. The package keeps its own copy, so
  // changing these later never edits a package that has already been built.
  roomType   String?
  mealPlan   String?
  // Null means "not stated", which is different from "non-refundable".
  refundable Boolean?

  servicesOffered String? @db.Text

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destination Destination   @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  // Phase 5: the same property is bought from several suppliers, each on its own terms, each with
  // its own rate card. See HotelVendor for why those terms cannot live on this row.
  vendors     HotelVendor[]
  rates       HotelRate[]

  @@index([destinationId])
  @@index([archived])
  // Declared here, not only in raw SQL, so Prisma stops planning a DROP for an index it
  // cannot see. A trigram index created outside the schema is invisible to drift detection
  // and gets removed by the next unrelated migration.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Hotel_searchText_trgm")
}

// ---------------------------------------------------------------------------
// Packages (EMV wholesale product)
// ---------------------------------------------------------------------------

model Package {
  id            String @id @default(uuid())
  destinationId String
  title         String
  days          Int
  nights        Int

  // Raw EMV wholesale price, per head. Never includes partner markup. childRawPrice defaults to
  // 0 — "children travel free" — same reasoning as VisaProduct.childFee, which this mirrors.
  adultRawPrice Decimal @db.Decimal(12, 2)
  childRawPrice Decimal @default(0) @db.Decimal(12, 2)

  inclusions String   @db.Text
  exclusions String   @db.Text
  gallery    String[]
  tags       String[]

  // Markdown, shown at the foot of the itinerary after the exclusions. Package-level rather than
  // destination-level because the questions are about THIS trip ("is the Bali swing included?"),
  // not about the country.
  faqs String? @db.Text

  // Phase 4: the cancellation policy is maintained once as tiers and referenced here, so "what
  // would this cost to cancel today" becomes a calculation rather than a paragraph someone reads.
  cancellationPolicyId String?

  // What insurance the package INCLUDES, in prose — "overseas medical to USD 100,000". The actual
  // policy number a traveller is covered by lives on the quote, because it is issued per booking.
  insuranceDetails String? @db.Text

  // Auto-generated EMV-branded quote PDF. Always available, no payment required.
  emvQuotePdfPath String?

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destination        Destination         @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  cancellationPolicy CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: Restrict)
  packageDays        PackageDay[]
  packageHotels    PackageHotel[]
  packageTransport PackageTransport[]
  holidayTypes     HolidayTypeOnPackage[]
  quotes           Quote[]

  @@index([destinationId])
  @@index([cancellationPolicyId])
  @@index([archived])
}

// Frozen copy of a DayTemplate. Intentionally has no FK to DayTemplate (locked rule 2).
model PackageDay {
  id          String @id @default(uuid())
  packageId   String
  dayNumber   Int
  title       String
  description String @db.Text

  // The one-line summary the itinerary card shows before anyone expands the day. `description`
  // stays the long-form text underneath it.
  brief String? @db.Text

  // Operational caveats for this specific day — "carry swimwear", "monument shut on Fridays".
  // Separate from `description` so the itinerary can style them as a warning rather than burying
  // them in prose the reader skims.
  notes String? @db.Text

  // "Inclusions in each daywise itinerary" — what THIS day covers. Package.inclusions stays as the
  // trip-wide list; this is the per-day breakdown a customer reads while comparing days.
  inclusions String? @db.Text

  coverImageUrl String?

  // Meals covered on this day. An array rather than three booleans so adding, say, high tea later
  // is an enum value instead of a migration on every reader.
  mealsIncluded MealType[]

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package Package           @relation(fields: [packageId], references: [id], onDelete: Restrict)
  events  PackageDayEvent[]

  @@index([packageId])
  @@index([archived])
}

/**
 * One scheduled item inside a day — "Arrive at DPS", "Ubud waterfall tour", "Dinner at hotel".
 *
 * Structured rows rather than prose because the itinerary view has to lay them on a timeline,
 * compute end times from durations, count meals, and render transfers with their own detail. None
 * of that is possible against a paragraph.
 *
 * Sub-events hang off `parentEventId`: a day tour with three stops is one event with three
 * children, which keeps the top level readable while the detail stays available on expand.
 */
model PackageDayEvent {
  id            String  @id @default(uuid())
  packageDayId  String
  parentEventId String?
  // Deliberately a plain column and NOT a foreign key. A package day is a frozen copy (locked rule
  // 2); a real relation here would let archiving an activity be refused because a package once
  // included it, which is exactly the coupling copy-on-select exists to avoid. It is a breadcrumb
  // for reporting — "how often did we sell this" — not a live link.
  sourceActivityId String?

  sortOrder   Int
  title       String
  description String?      @db.Text
  type        DayEventType @default(ACTIVITY)

  // Minutes from midnight (0-1439) — NOT a timestamp, and not the string "09:30".
  //
  // A package is a template sold for hundreds of departure dates, so an absolute date/time here
  // would be wrong for every trip but one; the real date comes from the quote's travel date plus
  // the day number. Minutes rather than a string because "ends at start + duration" has to be
  // arithmetic, and because it orders correctly without parsing.
  startMinute     Int?
  durationMinutes Int?

  mealsIncluded MealType[]

  // Free text: "Daily", "Not on Mondays", "Subject to weather". A schedule grammar would be a
  // small language to write and a smaller one to get right; this is read by humans.
  availability String?

  // Only meaningful when type = TRANSFER. Kept on the event rather than in a model of its own,
  // because a transfer between two points on a day IS an item on that day. The actually-booked
  // vehicle (flight number, PNR) belongs on the trip, never on this template.
  transferMode     String?
  luggageAllowance String?

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packageDay  PackageDay        @relation(fields: [packageDayId], references: [id], onDelete: Restrict)
  parentEvent PackageDayEvent?  @relation("EventSubEvents", fields: [parentEventId], references: [id], onDelete: Restrict)
  subEvents   PackageDayEvent[] @relation("EventSubEvents")

  @@index([packageDayId])
  @@index([parentEventId])
  @@index([archived])
}

/**
 * What travel the package INCLUDES, as a plan — "return economy flight, Delhi to Denpasar".
 *
 * Deliberately holds no flight number, no date and no PNR. A package is sold for hundreds of
 * departures; a real flight number here would be correct for one booking and wrong for every
 * other. The actuals live on QuoteTransport, which is created per trip.
 */
model PackageTransport {
  id        String @id @default(uuid())
  packageId String

  sortOrder Int           @default(0)
  mode      TransportMode @default(FLIGHT)

  fromCity String
  toCity   String

  // Which day of the itinerary this leg falls on, so the day-wise view can show it in place.
  dayNumber Int?

  // "Economy", "AC Sleeper", "Business" — the class the package promises, not the seat booked.
  classOfService String?

  notes String? @db.Text

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([packageId])
  @@index([archived])
}

// Frozen copy of a Hotel. Intentionally has no FK to Hotel (locked rule 2).
model PackageHotel {
  id               String @id @default(uuid())
  packageId        String
  hotelName        String
  hotelCategory    String
  hotelDescription String  @db.Text
  hotelAddress     String? @db.Text

  // Remote URL, not an upload — same reasoning as VisaCountry.coverImageUrl: uploads live on the
  // container's ephemeral disk and vanish on every deploy, which is fatal for marketing imagery.
  coverImageUrl String?

  // Our own star rating, 1-5. Distinct from the Google numbers below, which are somebody else's
  // measurement and are shown as such.
  starRating Int?

  mapLink          String?
  googleRating     Decimal? @db.Decimal(2, 1)
  googleRatingCount Int?

  // Times of day only ("14:00" as 840 minutes from midnight). The DATE a guest checks in is
  // derived from the quote's travel date — see voucherService.buildStays — so storing one here
  // would be wrong for every trip but the first.
  checkInMinute  Int?
  checkOutMinute Int?

  roomType String?
  mealPlan String?

  // Null means "not stated" rather than "non-refundable": showing a cancellation stance nobody
  // entered is worse than showing none.
  refundable Boolean?

  // "About the selected hotels including services offered".
  servicesOffered String? @db.Text

  // Nights spent at THIS hotel. Without it there is no way to say when a guest checks in or out:
  // the voucher's dates are derived by walking the hotels in sortOrder from the quote's travel
  // date, so the same package sold for two different departures produces two different vouchers.
  nights Int @default(1)

  // 0-based position in the hotelIds array the admin submitted. Hotels are presented in the
  // order the admin chose (flagship first, say), which alphabetical ordering would destroy.
  // Also the order the voucher walks to lay nights out along the trip.
  sortOrder Int @default(0)

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([packageId])
  @@index([archived])
}

// ---------------------------------------------------------------------------
// Quotes (partner white-label layer)
// ---------------------------------------------------------------------------

model Quote {
  id        String @id @default(uuid())
  packageId String
  partnerId String

  // Human-readable trip reference, quoted over the phone and printed at the top of the voucher.
  // Same role and format family as VisaRequest.applicationNumber — a uuid is unusable for that.
  quoteNumber String @unique

  leadName        String
  contactNumber   String
  email           String
  travelDate      DateTime @db.Date
  adults          Int
  children        Int      @default(0)
  infants         Int      @default(0)
  specialRequests String?  @db.Text

  // The package's per-head raw prices FROZEN at the instant this quote was created — the same
  // copy-on-select principle as rule 2, applied to price. All selling-price maths uses these,
  // never the live Package.adultRawPrice/childRawPrice, so an admin repricing a package can never
  // move the numbers on a quote a partner has already given their customer. Field kept named
  // `rawPriceAtQuote` (not renamed to `adultRawPriceAtQuote`) because it predates per-head pricing
  // and is read in enough places that renaming it would be pure churn — it now specifically means
  // the ADULT portion; childRawPriceAtQuote is the new sibling.
  rawPriceAtQuote      Decimal @db.Decimal(12, 2)
  childRawPriceAtQuote Decimal @default(0) @db.Decimal(12, 2)

  // sellingPrice = rawPriceAtQuote * adults + childRawPriceAtQuote * children + markupAmount
  // (locked rule 5, extended to per-head — see quoteService.computeSellingPrice).
  markupAmount Decimal @db.Decimal(12, 2)
  sellingPrice Decimal @db.Decimal(12, 2)

  // Tax Collected at Source on overseas tour packages.
  //
  // BOTH the rate and the computed amount are frozen here, for the same reason rawPriceAtQuote is:
  // the rate is set by government policy and changes, and an invoice already handed to a customer
  // must not silently re-tax itself when it does. Storing only the rate would still let a later
  // rounding change move the number; storing only the amount would lose the audit trail of which
  // rate produced it.
  //
  // Existing quotes carry 0/0 — they were priced before TCS was modelled, and retroactively adding
  // tax to them would misstate what the customer was actually told.
  tcsRate   Decimal @default(0) @db.Decimal(5, 2)
  tcsAmount Decimal @default(0) @db.Decimal(12, 2)

  branding Branding
  pdfPath  String?

  // Issued when the booking is confirmed (payment approved), not at quote time — an unconfirmed
  // trip has no voucher to reference. Null until then.
  voucherNumber   String? @unique
  itineraryNumber String? @unique

  status QuoteStatus @default(QUOTE_GENERATED)

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package    Package          @relation(fields: [packageId], references: [id], onDelete: Restrict)
  partner    User             @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  payments   Payment[]
  travellers QuoteTraveller[]
  transport  QuoteTransport[]
  insurance  QuoteInsurance[]
  snapshot   QuoteSnapshot?

  @@index([packageId])
  @@index([partnerId])
  @@index([status])
  @@index([archived])
}

// ---------------------------------------------------------------------------
// Payments (manual only — UPI/QR/bank + screenshot, admin-verified)
// ---------------------------------------------------------------------------

/**
 * A named person travelling on a quote.
 *
 * Quote.adults/children/infants stay as the counts the trip was PRICED on, and are what the
 * partner enters first. These rows are the names the voucher and the hotel need, added later once
 * the customer confirms. The two are deliberately not forced to agree at the database level: a
 * partner who has paid for 4 but only knows 2 names yet must still be able to save progress.
 */
model QuoteTraveller {
  id      String @id @default(uuid())
  quoteId String

  fullName String
  // Date of birth rather than a typed age: hotel child-occupancy rules are driven by age ON the
  // travel date, and a stored age silently goes stale as the trip approaches.
  dob      DateTime      @db.Date
  type     TravellerType @default(ADULT)

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@index([quoteId])
  @@index([archived])
}

/**
 * The travel actually booked for one trip — the flight number, the departure time, the seat class.
 *
 * Separate from PackageTransport because these are facts about a booking, not about a product.
 * Times are full timestamps here, unlike everywhere else in the itinerary, because a booked flight
 * departs at one absolute moment — there is no template left to resolve.
 */
model QuoteTransport {
  id      String @id @default(uuid())
  quoteId String

  sortOrder Int           @default(0)
  mode      TransportMode @default(FLIGHT)

  fromCity String
  toCity   String

  // "IndiGo", "6E-1234", "Airbus A320neo".
  operator     String?
  vehicleNumber String?
  vehicleModel String?

  departureAt DateTime?
  arrivalAt   DateTime?

  boardingPoint    String?
  seatClass        String?
  fareType         String?
  baggageAllowance String?
  bookingReference String?

  notes String? @db.Text

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@index([quoteId])
  @@index([archived])
}

/**
 * The insurance policy covering one trip.
 *
 * On the quote rather than the package for the same reason as QuoteTransport: a policy number is
 * issued per booking. Package.insuranceDetails describes what is included; this records what was
 * actually bought.
 */
model QuoteInsurance {
  id      String @id @default(uuid())
  quoteId String

  // Which catalogue plan this was sold from. Nullable because a partner may record a policy the
  // traveller arranged themselves, which belongs to no plan.
  insurancePlanId String?

  provider     String
  policyNumber String?

  coverageAmount Decimal? @db.Decimal(12, 2)
  validFrom      DateTime? @db.Date
  validTo        DateTime? @db.Date

  // Remote URL to the policy document, not an upload — uploads sit on the container's ephemeral
  // disk and are destroyed on every deploy, which is not acceptable for a document a traveller
  // may need to produce at a hospital.
  documentUrl String?

  notes String? @db.Text

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote         Quote          @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  insurancePlan InsurancePlan? @relation(fields: [insurancePlanId], references: [id], onDelete: Restrict)

  @@index([quoteId])
  @@index([insurancePlanId])
  @@index([archived])
}

model Payment {
  id   String      @id @default(uuid())
  type PaymentType

  // Exactly one of these is set, per `type`. Enforced in the service layer.
  quoteId       String?
  visaRequestId String?

  transactionId  String
  amount         Decimal @db.Decimal(12, 2)
  screenshotPath String
  notes          String? @db.Text

  // True when `amount` did not equal the quote's sellingPrice at submission time. Stored, not
  // derived, so it stays a frozen audit signal: partners legitimately pay in parts or round,
  // and the admin needs to see what was flagged when the money arrived.
  reconciliationMismatch Boolean @default(false)

  status       PaymentStatus @default(PENDING_VERIFICATION)
  adminRemarks String?       @db.Text
  verifiedById String?
  verifiedAt   DateTime?

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote       Quote?       @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  visaRequest VisaRequest? @relation(fields: [visaRequestId], references: [id], onDelete: Restrict)
  verifiedBy  User?        @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([quoteId])
  @@index([visaRequestId])
  @@index([verifiedById])
  @@index([type])
  @@index([status])
  @@index([archived])
}



// ---------------------------------------------------------------------------
// Suppliers and rates (Phase 5)
//
// Until now a hotel carried no price at all — the number lived inside a package, typed by hand, with
// no record of who quoted it, when it was valid, or what currency it was in. Maintaining a hotel
// centrally therefore bought nothing, which is the concrete reason the Library felt useless.
//
// The shape here follows how the trade actually contracts: one hotel is bought from SEVERAL
// suppliers, each with its own contract period, allocation, cancellation terms and currency, and
// each of those carries a table of rates by season, room type, meal plan and occupancy.
//
// None of this changes an issued quote. Phase 1 froze the itinerary and the price at quote
// generation, so a rate loaded today is a rate for the NEXT quote.
// ---------------------------------------------------------------------------

/**
 * Someone the business buys from.
 *
 * One row per supplier, not one per (supplier, hotel) — the contact details, payment terms and tax
 * numbers belong to the company. What varies per hotel lives on HotelVendor.
 */
model Vendor {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  types VendorType[]

  contactPerson String?
  email         String?
  phone         String?
  address       String? @db.Text
  website       String?

  countryId String?

  gstNumber String?
  panNumber String?

  // "30 days from invoice". Free text because every supplier words it differently and nothing
  // downstream calculates on it yet.
  paymentTerms String?
  creditDays   Int?

  // The currency this supplier normally contracts in. A default for new rate cards, not a
  // constraint — the same supplier may quote a beach property in USD and a city one in local money.
  defaultCurrencyCode String?

  notes String? @db.Text

  searchText String @default("")

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country         Country?      @relation(fields: [countryId], references: [id], onDelete: Restrict)
  defaultCurrency Currency?     @relation(fields: [defaultCurrencyCode], references: [code], onDelete: Restrict)
  hotelContracts  HotelVendor[]
  hotelRates      HotelRate[]
  activityRates   ActivityRate[]

  @@index([archived])
  @@index([countryId])
  @@index([defaultCurrencyCode])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Vendor_searchText_trgm")
}

/**
 * One supplier's contract for one hotel.
 *
 * This is the row that makes "a hotel belongs to several vendors" true rather than aspirational.
 * Allocation, release period, contract dates and cancellation terms all differ per supplier for the
 * SAME property, and flattening them onto the hotel would mean picking one supplier's terms and
 * quietly applying them to everyone.
 */
model HotelVendor {
  id       String @id @default(uuid())
  hotelId  String
  vendorId String

  // The supplier's own reference for the contract. Part of the unique key because a supplier may
  // hold two contracts on one property — a seasonal allotment and an ad-hoc one.
  contractRef String @default("")

  contractFrom DateTime? @db.Date
  contractTo   DateTime? @db.Date

  // Rooms held for us, and how many days before arrival unsold ones go back. Both are operational
  // facts that decide whether a booking can be confirmed instantly or has to be requested.
  allocationRooms Int?
  releaseDays     Int?

  cancellationPolicyId String?

  // Which supplier to quote from when several can supply the same room. A preference, not a rule —
  // the rate resolver still prefers whatever is actually cheaper on the dates asked for.
  isPreferred Boolean @default(false)

  notes String? @db.Text

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel              Hotel               @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  vendor             Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  cancellationPolicy CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: Restrict)
  rates              HotelRate[]

  @@unique([hotelId, vendorId, contractRef])
  @@index([hotelId])
  @@index([vendorId])
  @@index([archived])
  @@index([cancellationPolicyId])
}

/**
 * One line of a hotel rate card.
 *
 * A rate is only a number in the company of everything else on this row: which dates it is valid
 * for, what it is quoted per, which room and meal plan, which occupancy, and in what currency. Every
 * one of those has been the cause of a mispriced package somewhere.
 *
 * Overlapping validity ranges are permitted by the schema and resolved by hotelRateService, which
 * prefers the NARROWER range — a special rate loaded for one week must beat the season rate it sits
 * inside, and that is the whole reason someone loads it.
 */
model HotelRate {
  id            String  @id @default(uuid())
  hotelId       String
  // Which contract this rate came from. Nullable so a rate can be recorded before the contract is
  // captured, which is what always happens when someone is quoting against an emailed rate sheet.
  hotelVendorId String?
  vendorId      String?

  roomType  String
  mealPlan  String
  occupancy Occupancy @default(DOUBLE)

  // Inclusive on both ends: a rate valid "1 to 30 April" covers the 30th. Stated because half-open
  // ranges elsewhere in this schema make the other reading plausible.
  validFrom DateTime @db.Date
  validTo   DateTime @db.Date

  basis        RateBasis @default(PER_ROOM_PER_NIGHT)
  amount       Decimal   @db.Decimal(12, 2)
  currencyCode String

  // Tax quoted separately by most suppliers, so it is stored separately rather than folded into the
  // amount where nobody could tell it apart afterwards.
  taxPercent Decimal? @db.Decimal(5, 2)

  minNights Int?
  maxNights Int?

  // Dates inside the validity range where this rate does NOT apply — a peak weekend carved out of a
  // season rate. Stored as dates rather than prose so the resolver can honour them.
  blackoutDates DateTime[] @db.Date

  // Off means loaded but not yet usable for quoting. Rates arrive as a spreadsheet and are checked
  // before anyone sells against them.
  isPublished Boolean @default(false)

  notes String? @db.Text

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel       Hotel        @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  hotelVendor HotelVendor? @relation(fields: [hotelVendorId], references: [id], onDelete: Restrict)
  vendor      Vendor?      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  currency    Currency     @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@index([hotelId, validFrom, validTo])
  @@index([hotelVendorId])
  @@index([vendorId])
  @@index([currencyCode])
  @@index([archived])
  @@index([isPublished])
}

/**
 * A thing a traveller does, maintained once.
 *
 * Day templates and package days currently hold activities as free-text event titles, so the same
 * Bali swing is described differently in every itinerary and cannot be priced, filtered or reported
 * on. An Activity is the row that fixes that; the events keep their copied text (locked rule 2) and
 * gain a reference back to it.
 */
model Activity {
  id            String @id @default(uuid())
  destinationId String
  name          String
  slug          String @unique

  description String? @db.Text
  // Free text rather than an enum: matched against the ACTIVITY_CATEGORY vocabulary in the library,
  // which an admin extends without a deploy.
  category    String?

  durationMinutes Int?
  // Where a template puts it by default. Minutes from midnight, like every other time in this
  // schema, because a template has no date to hang a timestamp off.
  suggestedStartMinute Int?

  meetingPoint String? @db.Text
  inclusions   String? @db.Text
  exclusions   String? @db.Text
  notes        String? @db.Text

  coverImageUrl String?
  images        String[]

  minAgeYears Int?
  maxPax      Int?

  searchText String @default("")

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destination       Destination        @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  rates             ActivityRate[]
  dayTemplateEvents DayTemplateEvent[]

  @@index([destinationId])
  @@index([archived])
  @@index([category])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Activity_searchText_trgm")
}

/**
 * One price for one activity.
 *
 * Several per activity, for the same reason hotels have rate cards: an adult ticket, a child ticket,
 * a private transfer and a seat-in-coach are four different numbers for the same experience, and
 * each is valid for its own season.
 */
model ActivityRate {
  id         String  @id @default(uuid())
  activityId String
  vendorId   String?

  paxType  PaxType       @default(ADULT)
  transfer TransferBasis @default(SIC)

  validFrom DateTime @db.Date
  validTo   DateTime @db.Date

  amount       Decimal @db.Decimal(12, 2)
  currencyCode String

  // A GROUP rate covers everyone between these two counts for one price.
  minPax Int?
  maxPax Int?

  isPublished Boolean @default(false)
  notes       String? @db.Text

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activity Activity  @relation(fields: [activityId], references: [id], onDelete: Restrict)
  vendor   Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  currency Currency  @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@index([activityId, validFrom, validTo])
  @@index([vendorId])
  @@index([currencyCode])
  @@index([archived])
  @@index([isPublished])
}

// ---------------------------------------------------------------------------
// Reusable content (Phase 4)
//
// Everything here exists because the same paragraph was being retyped. A visa checklist asked for
// "Bank Statement" in one product and "6-month bank statements" in another; a cancellation policy
// lived as prose inside each package; the same FAQ was pasted onto every destination.
//
// The rule that makes this safe is Phase 1's: a quote snapshots at generation. Editing a note or a
// policy therefore changes what FUTURE quotes say, never what an issued one said.
// ---------------------------------------------------------------------------

/**
 * A kind of document, named once.
 *
 * `VisaRequiredDocument.documentName` was free text, so the "documents required" filter could never
 * work on it and no two products agreed on a name. A document type is the row that fixes that: the
 * checklist points at it, and the wording changes in one place.
 */
model DocumentType {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  category VisaDocumentCategory @default(OTHER)
  subject  DocumentSubject      @default(TRAVELLER)

  description String? @db.Text
  // What a good one looks like. A specimen removes most of the back-and-forth on a rejected upload.
  sampleImageUrl String?
  // "Valid for at least 6 months beyond the travel date." Guidance, not validation.
  requirementNotes String? @db.Text

  // The usual answer, which a product may still override — a passport is mandatory almost
  // everywhere, an old visa copy almost nowhere.
  isMandatoryByDefault Boolean @default(true)

  sortOrder  Int    @default(0)
  searchText String @default("")

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visaRequirements VisaRequiredDocument[]
  requestSnapshots VisaRequestRequiredDoc[]
  uploads          VisaDocumentUpload[]

  @@index([archived])
  @@index([category])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "DocumentType_searchText_trgm")
}

/**
 * A question and its answer, written once and attached wherever it applies.
 *
 * Attached through EntityLink rather than a foreign key per owner: the same question belongs on a
 * country, a destination, a package and a visa product, and a column per owner would mean altering
 * this table every time something new wants FAQs.
 */
model FaqItem {
  id       String @id @default(uuid())
  question String
  answer   String @db.Text

  // Free text rather than an enum: these are editorial groupings ("Before you fly", "Payments")
  // that the people writing FAQs invent, and an enum would make them wait for a deploy.
  category String?

  sortOrder  Int    @default(0)
  searchText String @default("")

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archived])
  @@index([category])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "FaqItem_searchText_trgm")
}

/**
 * A named block of prose — terms, scope of services, general notes.
 *
 * This is the former `ContentBlock`, extended rather than replaced. The physical table keeps its old
 * name (see @@map) because renaming it in the same deploy that adds its replacement is exactly the
 * kind of change that 500s a container mid-rollout. The rename belongs to a contract step.
 *
 * `key` is what a document looks a block up by, so it is stable and never edited; the title and body
 * are what an admin rewrites without a deploy.
 */
model NoteBlock {
  id   String @id @default(uuid())
  // Renamed from `name` in code only — same column, so no data moves.
  key  String @unique @map("name")
  type NoteBlockType @default(OTHER)

  title String
  body  String @db.Text

  // True for the company-wide blocks printed at the foot of every voucher. False for a block that
  // only applies where it has been attached, which is what EntityLink records.
  isGlobal Boolean @default(true)

  sortOrder  Int    @default(0)
  searchText String @default("")

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archived])
  @@index([type])
  @@map("ContentBlock")
}

/**
 * A cancellation policy, as tiers rather than a paragraph.
 *
 * Written as prose it can only be printed. As tiers it can also be applied: "what would this cost to
 * cancel today" is a calculation the system can do, which is the question a partner actually asks.
 */
model CancellationPolicy {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  description String? @db.Text
  // Prose to print alongside the table, for the wording that tiers cannot express.
  notes       String? @db.Text

  searchText String @default("")

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiers          CancellationTier[]
  packages       Package[]
  hotelContracts HotelVendor[]

  @@index([archived])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "CancellationPolicy_searchText_trgm")
}

/**
 * One band of a cancellation policy: "30 days or more before travel, 25%".
 *
 * Bands are half-open on `daysBeforeTravelMin` and expressed as a range so a gap or an overlap is
 * visible in the data rather than hidden in prose. A tier with no maximum is the outermost band.
 */
model CancellationTier {
  id       String @id @default(uuid())
  policyId String

  // Inclusive lower bound in days before departure. 0 means "on the day or after".
  daysBeforeTravelMin Int
  // Exclusive upper bound, null for the outermost band.
  daysBeforeTravelMax Int?

  chargeType  CancellationChargeType @default(PERCENT_OF_TOTAL)
  // Percent when PERCENT_OF_TOTAL, an amount when FIXED_AMOUNT, a count when NIGHTS, ignored for
  // NONE. Decimal because a half-percent band is a real thing.
  chargeValue Decimal @default(0) @db.Decimal(12, 2)

  // Only meaningful for FIXED_AMOUNT. Present because a fixed charge without a currency is not a
  // number anyone can act on, and this system must not assume INR.
  currencyCode String?

  sortOrder Int @default(0)

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policy   CancellationPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  currency Currency?          @relation(fields: [currencyCode], references: [code], onDelete: Restrict)

  @@index([policyId])
  @@index([archived])
  @@index([currencyCode])
}

/**
 * An insurance product that can be sold with a trip.
 *
 * `QuoteInsurance` records the policy a specific traveller was actually issued — a number, a
 * document, real dates. This is the catalogue entry it was sold from.
 */
model InsurancePlan {
  id       String @id @default(uuid())
  name     String
  slug     String @unique
  provider String

  coverageSummary String? @db.Text
  inclusions      String? @db.Text
  exclusions      String? @db.Text
  brochureUrl     String?

  coverageAmount Decimal? @db.Decimal(12, 2)
  premiumAdult   Decimal? @db.Decimal(12, 2)
  premiumChild   Decimal? @db.Decimal(12, 2)
  // One currency for every amount on the plan. A plan priced in USD with cover quoted in INR is a
  // data-entry mistake, not a case worth modelling.
  currencyCode   String?

  // Eligibility. Age bands are where insurance claims are actually refused, so they are columns
  // rather than a line in the summary.
  minAgeYears     Int?
  maxAgeYears     Int?
  maxTripDays     Int?

  sortOrder  Int    @default(0)
  searchText String @default("")

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currency       Currency?        @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  quoteInsurance QuoteInsurance[]

  @@index([archived])
  @@index([currencyCode])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "InsurancePlan_searchText_trgm")
}

// ---------------------------------------------------------------------------
// Visa services
// ---------------------------------------------------------------------------

/**
 * One sellable visa option for a country — "Tourist eVisa (30 days)", "Visa on Arrival".
 *
 * A country is not a product: Thailand offers Visa on Arrival AND an eVisa, with different
 * processing times, documents and fees, and Country.baseFee can only hold one of them. Every
 * filter the marketplace needs (category, speed, documents) is a property of the option, not of
 * the country, so the options have to be rows of their own.
 *
 * Country.baseFee stays as the country-level default and is what pre-migration requests were
 * priced from; new requests snapshot VisaProduct.adultFee/childFee instead.
 */
model VisaProduct {
  id        String @id @default(uuid())
  countryId String
  name      String

  category VisaCategory

  // Working days, as NUMBERS rather than the bucket the UI shows ("within a week").
  //
  // The buckets nest — instant ⊂ within a day ⊂ within a week ⊂ within a month — so a stored
  // bucket makes "within a month" exclude the instant products unless the hierarchy is hand-coded
  // in every query. A number makes the filter a plain `processingDaysMax <= n`, which nests for
  // free, sorts, and still prints the real range ("3–5 working days") on the card.
  //
  // Nullable because an admin may not know the timeline yet. A product with no timeline is never
  // matched by a speed filter — it must not claim a speed it cannot deliver.
  processingDaysMin Int?
  processingDaysMax Int?

  // Three different day counts that are easy to confuse, so all three are named explicitly:
  //   processingDays*  how long it takes to GET the visa   (above)
  //   validityDays     how long the visa stays valid after issue
  //   maxStayDays      how long one visit may last
  // Nullable for the same reason as the processing days — an unknown number must not be printed
  // on a card as if it were confirmed.
  validityDays Int?
  maxStayDays  Int?

  entryType VisaEntryType @default(SINGLE)

  // Per-passenger wholesale fees, frozen onto the request at create time (rule 2).
  //
  // Two columns rather than one because consulates price children below adults, so what a request
  // is worth depends on the passenger MIX. childFee is a real 0 when children travel free — it is
  // not "unset", which is why it is not nullable.
  adultFee Decimal @default(0) @db.Decimal(12, 2)
  childFee Decimal @default(0) @db.Decimal(12, 2)

  // Markdown. Product-level, unlike the country's arrival info: the questions partners ask are
  // about THIS visa ("can I extend it?", "is biometrics needed?"), and differ between an eVisa and
  // a sticker visa for the same country.
  faqs String? @db.Text

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country           Country                @relation(fields: [countryId], references: [id], onDelete: Restrict)
  requiredDocuments VisaRequiredDocument[]
  processingSteps   VisaProcessingStep[]
  visaRequests      VisaRequest[]

  @@index([countryId])
  @@index([archived])
  @@index([category])
  @@index([processingDaysMax])
}

/**
 * One stage of "Processing Timeline — total time, each step explained with estimated time".
 *
 * Structured rows rather than a markdown blob, because each step carries its own number of days
 * and the UI adds them up and renders them as a progress track. Prose could not be summed, and
 * the total would drift out of step with processingDaysMax the first time someone edited one.
 */
model VisaProcessingStep {
  id            String @id @default(uuid())
  visaProductId String

  // Explicit rather than relying on insertion order: steps get inserted, reordered and re-added
  // by the archive-and-replace edit pattern, and "whatever order the rows came back in" is not an
  // order at all.
  sortOrder   Int
  title       String
  description String? @db.Text

  // Working days for THIS step. Nullable so a step whose duration nobody can commit to
  // ("consulate review") can still be listed without inventing a number.
  estimatedDays Int?

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visaProduct VisaProduct @relation(fields: [visaProductId], references: [id], onDelete: Restrict)

  @@index([visaProductId])
  @@index([archived])
}

/**
 * The document checklist for ONE product, not for the whole country: an eVisa typically needs a
 * passport scan and a photo, while the sticker visa for the same country wants bank statements and
 * an ITR. Hanging this off the country would force both to share one list.
 */
model VisaRequiredDocument {
  id            String  @id @default(uuid())
  visaProductId String
  // Phase 4: the checklist now points at a named document type. `documentName` stays as the
  // authored label — a product may legitimately say "Passport (first and last page)" where the type
  // is simply "Passport" — and as the fallback for rows written before types existed.
  documentTypeId String?
  documentName  String
  isMandatory   Boolean @default(true)

  // What kind of document this is, for filtering. documentName stays free text and is what the
  // partner actually reads; this is the machine-readable half.
  category VisaDocumentCategory @default(OTHER)

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visaProduct  VisaProduct   @relation(fields: [visaProductId], references: [id], onDelete: Restrict)
  documentType DocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  @@index([visaProductId])
  @@index([documentTypeId])
  @@index([archived])
  @@index([category])
}

model VisaRequest {
  id        String @id @default(uuid())
  partnerId String
  countryId String

  // Nullable only because requests created before visa products existed have no product to point
  // at. Every new request sets it — visaRequestService requires a product on create — and
  // baseFeeAtRequest is snapshotted from the product's fee rather than the country's.
  visaProductId String?

  applicationNumber String @unique

  status VisaRequestStatus @default(APPLICATION_SUBMITTED)
  visaType VisaType @default(REGULAR)

  // The country's baseFee FROZEN at the instant this request was created — copy-on-select
  // (rule 2) applied to visa pricing, the same principle as Quote.rawPriceAtQuote. All
  // selling-price maths uses THIS column, never the live Country.baseFee, so an admin
  // repricing a country can never move the numbers on a request already in flight.
  // passengerCount is NOT stored separately: passengers can only be edited while
  // APPLICATION_SUBMITTED (see visaRequestService.EDITABLE_STATUSES), so the live count of
  // non-archived VisaPassenger rows IS the count basis right up until payment locks everything —
  // at which point passengers can no longer change, so the count is fixed by construction.
  baseFeeAtRequest Decimal @default(0) @db.Decimal(12, 2)

  // The product's two fees, frozen at the same instant and for the same reason as
  // baseFeeAtRequest. Both are snapshotted even when no children are travelling: a child added
  // while the request is still editable must be priced at the rate that applied when the request
  // was created, not at whatever the admin has changed it to since.
  //
  // adultFeeAtRequest is kept equal to baseFeeAtRequest on new requests, so anything still reading
  // the old column stays correct. baseFeeAtRequest remains the ONLY fee on requests created before
  // visa products existed.
  adultFeeAtRequest Decimal @default(0) @db.Decimal(12, 2)
  childFeeAtRequest Decimal @default(0) @db.Decimal(12, 2)

  // Partner's profit. sellingPrice = baseFeeAtRequest * passengerCount + markupAmount, computed
  // server-side on create and recomputed (from the snapshot fee, never live) whenever passengers
  // and/or markupAmount are edited.
  markupAmount Decimal @db.Decimal(12, 2) @default(0)
  sellingPrice Decimal @db.Decimal(12, 2) @default(0)
  evisaDocumentPath String?

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner             User                     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  country             Country                  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  visaProduct         VisaProduct?             @relation(fields: [visaProductId], references: [id], onDelete: Restrict)
  passengers          VisaPassenger[]
  payments            Payment[]
  requiredDocSnapshot VisaRequestRequiredDoc[]

  @@index([partnerId])
  @@index([countryId])
  @@index([visaProductId])
  @@index([status])
  @@index([archived])
}

// Frozen copy of the country's required-document checklist, taken at the instant a VisaRequest
// is created. Deliberately has NO FK to VisaRequiredDocument — the same copy-on-select principle
// as PackageDay/PackageHotel (rule 2) and Quote.rawPriceAtQuote, applied a third time. Without
// this, readyToSubmit read the country's LIVE checklist: an admin editing the checklist after a
// partner created their request would shift the requirements underneath them, potentially
// blocking payment for someone who had already satisfied the checklist as it stood.
model VisaRequestRequiredDoc {
  id            String  @id @default(uuid())
  visaRequestId String
  // Which library document type this line came from. The NAME stays the frozen copy (locked rule
  // 2) — it is what the partner was told to produce and must not change if the library is reworded.
  // The reference is what lets the upload screen show the specimen and the requirement notes, and
  // lets "how many passport scans are outstanding" be a query rather than a string comparison.
  documentTypeId String?
  documentName  String
  isMandatory   Boolean @default(true)

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visaRequest  VisaRequest   @relation(fields: [visaRequestId], references: [id], onDelete: Restrict)
  documentType DocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  @@index([visaRequestId])
  @@index([documentTypeId])
  @@index([archived])
}

model VisaPassenger {
  id            String @id @default(uuid())
  visaRequestId String

  fullName String
  gender   String

  // Which of the product's two fees this passenger is charged at. Stored rather than derived from
  // dob: the adult/child cutoff age differs per country and per consulate, and a stored value
  // cannot silently reprice an existing request when a passenger has a birthday.
  passengerType PassengerType @default(ADULT)

  dob         DateTime @db.Date
  nationality String
  passportNumber String
  passportExpiry DateTime @db.Date
  travelDate     DateTime @db.Date
  returnDate     DateTime @db.Date

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visaRequest     VisaRequest          @relation(fields: [visaRequestId], references: [id], onDelete: Restrict)
  documentUploads VisaDocumentUpload[]

  @@index([visaRequestId])
  @@index([archived])
}

// documentName is a copied string, not an FK to VisaRequiredDocument, so that changing a
// country's document config never mutates already-submitted applications (locked rule 2).
model VisaDocumentUpload {
  id              String @id @default(uuid())
  visaPassengerId String
  // What KIND of document this file is. Until now an upload was tied to its checklist line only by
  // comparing documentName strings, so a reworded checklist orphaned every file already uploaded
  // against it — the same name-matching fragility Phase 3 removed between destinations and visas.
  documentTypeId  String?
  documentName    String
  filePath        String

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visaPassenger VisaPassenger @relation(fields: [visaPassengerId], references: [id], onDelete: Restrict)
  documentType  DocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)

  @@index([visaPassengerId])
  @@index([documentTypeId])
  @@index([archived])
}

// ---------------------------------------------------------------------------
// Notifications & CMS
// ---------------------------------------------------------------------------

model Notification {
  id      String  @id @default(uuid())
  userId  String
  type    String
  message String  @db.Text
  isRead  Boolean @default(false)

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([isRead])
  @@index([archived])
}


/**
 * Small key/value store for operational numbers an admin must be able to change without a deploy —
 * currently the TCS rate.
 *
 * Values are strings so one table can hold any setting; each reader parses its own. A column per
 * setting would mean a migration every time a new one is needed.
 */
model AppSetting {
  key   String @id
  value String

  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  id      String @id @default(uuid())
  name    String @unique
  subject String
  body    String @db.Text

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archived])
}

/**
 * "Type of holidays" — beach, honeymoon, adventure, pilgrimage, family.
 *
 * A table rather than the free-text `Package.tags` array it replaces for this purpose: tags cannot
 * be renamed centrally, cannot carry an icon or an ordering, and accumulate near-duplicates
 * ("honeymoon", "Honeymoon", "honey moon") that then fail to match a filter. `tags` stays for
 * genuinely ad-hoc labelling.
 *
 * Attached to both packages and destinations, because a partner browses both ways: "show me
 * honeymoon packages" and "which destinations suit a honeymoon".
 */
model HolidayType {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  description String? @db.Text
  // Icon name from the frontend's own set, not an image URL — these render inline in filter chips.
  icon        String?
  imageUrl    String?

  // Display order in pickers and filter bars; alphabetical would bury the common ones.
  sortOrder Int @default(0)

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packages     HolidayTypeOnPackage[]
  destinations HolidayTypeOnDestination[]

  @@index([archived])
}

// Explicit join tables rather than implicit many-to-many: they carry their own timestamps, and a
// named table is something migrations and queries can talk about.
model HolidayTypeOnPackage {
  packageId     String
  holidayTypeId String
  createdAt     DateTime @default(now())

  package     Package     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  holidayType HolidayType @relation(fields: [holidayTypeId], references: [id], onDelete: Restrict)

  @@id([packageId, holidayTypeId])
  @@index([holidayTypeId])
}

model HolidayTypeOnDestination {
  destinationId String
  holidayTypeId String
  createdAt     DateTime @default(now())

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  holidayType HolidayType @relation(fields: [holidayTypeId], references: [id], onDelete: Restrict)

  @@id([destinationId, holidayTypeId])
  @@index([holidayTypeId])
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

enum MediaKind {
  IMAGE
  VIDEO
  // Cloudinary's name for "anything else" — PDFs, docs. Used by the private-document pass.
  RAW
}

enum MediaVisibility {
  // Delivered from a plain https URL. Correct for marketing imagery, which is meant to be seen.
  PUBLIC
  // Cloudinary "authenticated" delivery: the URL alone opens nothing, a short-lived signed URL
  // has to be minted per request. Required for passports, bank statements and payment proofs.
  AUTHENTICATED
}

/**
 * One file stored in Cloudinary.
 *
 * Exists because a URL is not enough to manage a file. Deleting or replacing one needs Cloudinary's
 * `public_id`, and that cannot be parsed back out of a delivery URL with any confidence — versions,
 * transformations and nested folders all end up in the path. So it is recorded at upload time.
 *
 * One central table rather than a publicId column beside each of the dozen existing URL columns:
 * delete lives in one place, orphaned files can be found, and adding the next media field does not
 * mean another migration.
 *
 * The owner is polymorphic and deliberately NOT a foreign key. An asset is uploaded BEFORE the row
 * it belongs to exists (you pick a cover image while creating the country), so a FK would be
 * unsatisfiable at insert time; and it can point at any of a dozen tables, which no single FK can
 * express. The trade-off is that nothing at the database level stops a stale ownerId — the media
 * list is the tool for finding those.
 */
model MediaAsset {
  id String @id @default(uuid())

  // Cloudinary's identifier. Unique because it IS the file: two rows pointing at one public_id
  // would let one delete silently break the other.
  publicId String @unique

  // Delivery URL. For AUTHENTICATED assets this is not directly usable — it is kept so the asset
  // can be identified in a listing, and a signed URL is minted per request instead.
  url String

  kind       MediaKind       @default(IMAGE)
  visibility MediaVisibility @default(PUBLIC)
  folder     String

  format           String?
  bytes            Int?
  width            Int?
  height           Int?
  originalFilename String?

  // What this file is for, e.g. "visaCountry" + "cover". Purpose is what the upload signature was
  // issued against, so it also records which folder rule applied.
  purpose   String
  ownerType String?
  ownerId   String?

  uploadedById String?

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purpose])
  @@index([ownerType, ownerId])
  @@index([archived])
}

/**
 * The itinerary a quote actually promised, frozen at the moment the quote was generated.
 *
 * WHY THIS EXISTS
 * A quote used to freeze its price and nothing else, while the voucher read the package LIVE. An
 * admin editing a package's hotels or day plan therefore rewrote vouchers that customers were
 * already holding, silently and with no record. Only the number was safe; the promise was not.
 *
 * This row is that promise. It is written once, inside the same transaction that creates the quote,
 * and never updated. Everything customer-facing — voucher, invoice, PDF — reads it instead of the
 * live library.
 *
 * WHY JSONB RATHER THAN SHADOW TABLES
 * A relational snapshot would need a mirror of every entity a quote can touch, kept in step with the
 * live schema forever. A document is one row, is exact, and never needs migrating: an eighteen-
 * month-old voucher still renders from the shape the system had when it was issued. It is never
 * queried for analytics — reporting reads the live entities and the quote's own numeric columns,
 * which stay relational.
 */
model QuoteSnapshot {
  id      String @id @default(uuid())
  quoteId String @unique

  // Bumped whenever the document's shape changes. The renderer branches on this rather than
  // guessing, so old snapshots keep working instead of erroring on a missing section.
  schemaVersion Int      @default(1)
  capturedAt    DateTime @default(now())

  document Json

  createdAt DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
}


// ---------------------------------------------------------------------------
// Library foundations (Phase 2)
// ---------------------------------------------------------------------------

/**
 * The vocabularies that are genuinely the same shape: a named option with no behaviour of its own.
 *
 * One table rather than eight near-identical ones. The dividing line against a master entity is
 * BEHAVIOUR - an inclusion is a label, a hotel has coordinates, a vendor and a rate card. Anything
 * with fields of its own gets a table of its own; a vocabulary that later grows real fields is
 * promoted out of here, which is a migration rather than a redesign.
 *
 * A fully generic key-value store for ALL master data is the classic MDM mistake. This is
 * deliberately not that - it covers vocabularies only.
 */
enum LookupType {
  TRIP_TYPE
  PACKAGE_CATEGORY
  INCLUSION
  EXCLUSION
  AMENITY
  ROOM_TYPE
  MEAL_PLAN
  ACTIVITY_CATEGORY
  // A package's free-typed tags ("Family", "Honeymoon"...) had no library backing at all before
  // this — just a hardcoded suggestion list in PackageFormPage and whatever a partner happened to
  // type. Governing them the same way as every other vocabulary is what lets "Family" and "family"
  // stop being two different tags by accident.
  PACKAGE_TAG
}

model LookupItem {
  id   String     @id @default(uuid())
  type LookupType

  name        String
  slug        String
  description String? @db.Text
  // An icon NAME from the frontend's own set, not a URL - these render inline in filter chips.
  icon        String?
  imageUrl    String?

  // Display order in pickers. Alphabetical would bury the options people pick most.
  sortOrder Int @default(0)

  // Lower-cased haystack maintained on write. See utils/searchText.js for why this is a column
  // rather than an expression index or a database trigger.
  searchText String @default("")

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique per type, not globally: "Standard" is a legitimate room type AND package category.
  @@unique([type, slug])
  @@index([type, archived])
  @@index([sortOrder])
  // Declared here, not only in raw SQL, so Prisma stops planning a DROP for an index it
  // cannot see. A trigram index created outside the schema is invisible to drift detection
  // and gets removed by the next unrelated migration.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "LookupItem_searchText_trgm")
}

/**
 * ISO 4217 currencies.
 *
 * Exists because no commercial value in this system may assume INR. Every price is paired with a
 * code from here, so adding a second selling currency becomes data entry rather than a migration.
 *
 * Exchange rates are deliberately absent for now: a rate needs a source, a timestamp and a policy
 * about which rate applies to which transaction. Inventing that before it is needed would bake in
 * the wrong answer.
 */
model Currency {
  code   String @id // ISO 4217, e.g. INR, USD, AED
  name   String
  symbol String

  // Most currencies use 2; JPY uses 0. Rounding a price at the wrong scale is a real money bug.
  decimalDigits Int @default(2)

  // Exactly one row should carry this. It is what reports total in and what a new price defaults to.
  isBaseCurrency Boolean @default(false)

  sortOrder Int     @default(0)
  archived  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  countries         Country[]
  cancellationTiers CancellationTier[]
  insurancePlans    InsurancePlan[]
  vendors           Vendor[]
  hotelRates        HotelRate[]
  activityRates     ActivityRate[]

  @@index([archived])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  DELETE
}

/**
 * Who changed what, when, and from what to what.
 *
 * ERP-wide infrastructure, not a Library feature: `entityType` is a plain string so any module -
 * quotes, payments, visa requests, future vendor contracts - records through the same table and the
 * same service without this schema changing again.
 *
 * THREE THINGS THAT MAKE THIS AN AUDIT LOG RATHER THAN A CHANGE FEED
 *
 * 1. The actor is DENORMALISED. actorEmail and actorRole are copied at write time, never joined
 *    from User. A trail that goes blank when an employee is archived is not a trail.
 * 2. `before`/`after` hold ONLY the fields that changed, not whole rows. Small enough to keep
 *    forever, and readable as a diff without tooling.
 * 3. There is no update path and no `archived` column. Rows are written once. Soft-deleting an
 *    audit log would defeat the point of having one.
 */
model AuditLog {
  id String @id @default(uuid())

  entityType String
  entityId   String
  action     AuditAction

  // Queryable on its own: "who has ever changed a visa fee" should not require reading every
  // JSON document in the table.
  changedFields String[]

  before Json?
  after  Json?

  // Optional free text from the caller - "corrected after supplier email", "annual revision".
  reason String? @db.Text

  actorId    String?
  actorEmail String?
  actorRole  String?
  // From req.ip, which is the real client only because index.js sets `trust proxy` behind the ALB.
  actorIp    String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Generic linking
// ---------------------------------------------------------------------------

/**
 * Attaches a reusable library item to any parent.
 *
 * FAQs, notes, documents and policies each attach to several parent types. A join table per
 * (child x parent) pair would be roughly thirty tables; one fully-generic table gives up all
 * referential integrity. This is the middle path, and the same compromise already accepted for
 * MediaAsset - so the codebase has one convention rather than two.
 *
 * Both sides are strings because the CHILD is polymorphic too: a link may point at a FaqItem, a
 * NoteBlock, a DocumentType or a LookupItem. The integrity cost is real and stated - nothing at the
 * database level stops either id pointing at a row that no longer exists. Mitigated by archiving
 * links in the same transaction as their parent, and by an integrity report that lists orphans.
 *
 * Ordinary many-to-many between two KNOWN tables still uses a normal join table with two real
 * foreign keys. This is only for genuinely many-parented content.
 */
model EntityLink {
  id String @id @default(uuid())

  // What is being attached.
  itemType String
  itemId   String

  // What it is attached to.
  ownerType String
  ownerId   String

  // Distinguishes several link sets on one owner: a package has inclusions AND exclusions, both
  // pointing at LookupItem rows.
  role String @default("default")

  sortOrder Int @default(0)

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One link per item per owner per role. Stops the double-click duplicate.
  @@unique([itemType, itemId, ownerType, ownerId, role])
  @@index([ownerType, ownerId, role])
  @@index([itemType, itemId])
  @@index([archived])
}
