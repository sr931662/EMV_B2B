# Server
PORT=4000
NODE_ENV=development

# Database — local docker-compose default. For a hosted Postgres (e.g. Neon) use:
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require&connect_timeout=20
# Neon auto-suspends idle computes, so the first query after a pause must wait out a
# cold start. Without a raised connect_timeout Prisma gives up after 5s and reports
# P1001 "Can't reach database server" even though the host is perfectly healthy.
# Do NOT add pool_timeout here: the query engine accepts it but the schema engine
# rejects it, and every `prisma migrate`/`validate` command then fails with a
# misleading P1001 as though the database were unreachable.
# Put the real credential in .env (gitignored), never in this file.
DATABASE_URL="postgresql://neondb_owner:npg_NFQja5Gl9OJB@ep-round-pond-ayal8m3j.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=20"

# Allowed frontend origins (CORS). Comma-separated, no trailing slash, scheme included —
# matched as exact origins, so a path or trailing "/" will never match. UNSET = ALLOW ALL,
# which is only acceptable locally; always pin this in a deployed environment.
#
#   local dev   http://localhost:5173
#   Cloudflare  https://<project>.pages.dev  (add the custom domain too once it is live)
#
# Vite is not pinned to a port, so it falls back to 5174/5175 when 5173 is taken — list the
# fallbacks locally, and list localhost and 127.0.0.1 separately since they are distinct origins.
CORS_ORIGIN=http://localhost:5173/,https://emv-b2b.pages.dev/

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# EMAIL_TRANSPORT selects how mail leaves the app. All three are implemented in
# src/services/emailService.js and share one interface, so switching is env-only:
#
#   console  (default) renders each email to stdout. Safe with no credentials —
#            this is how OTP codes are read during local development.
#   smtp     generic SMTP relay, using the SMTP_* values below.
#   ses      Amazon SES via the AWS SDK. Used in the ECS Fargate deployment.
#
EMAIL_TRANSPORT=console

# --- Generic SMTP relay (EMAIL_TRANSPORT=smtp) ---
#
# SMTP_USER and the address inside SMTP_FROM MUST be the same account. A relay only sends as the
# account you authenticated with (or an address verified as a "Send mail as" alias on it); any
# other From is silently REWRITTEN. The send still succeeds, so the only symptom is the wrong
# sender arriving in someone's inbox. emailService warns once at send time if these disagree.
#
# On Gmail, SMTP_PASS is an App Password (Google Account > Security > App passwords, requires
# 2-Step Verification) — never the account's login password.
#
# Real values belong in .env, which is gitignored. Never commit a working credential here.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=replace_with_app_password
SMTP_FROM="TravNexa Global <no-reply@example.com>"

# --- Amazon SES (EMAIL_TRANSPORT=ses) ---
#
# No access keys here on purpose. In ECS the task role supplies short-lived rotating
# credentials automatically; locally the SDK reads `aws configure` / AWS_PROFILE.
# Never put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in this file.
#
# SES_FROM_ADDRESS must be a VERIFIED identity in the sending region, otherwise SES
# rejects the send. While the account is in the SES sandbox, every recipient must be
# verified too — see infra/DEPLOYMENT.md for how to request production access.
#
# AWS_REGION is injected by ECS; set it locally only if you want to test SES from your
# machine. SES_REGION overrides it when the identity lives in another region.
# AWS_REGION=ap-south-1
# SES_REGION=ap-south-1
SES_FROM_ADDRESS="TravNexa Global <no-reply@yourdomain.com>"
# SES_REPLY_TO=support@yourdomain.com
# Optional. Routes bounce/complaint/delivery events and keeps reputation metrics.
# SES_CONFIGURATION_SET=travnexa-prod
