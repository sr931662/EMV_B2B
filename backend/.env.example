# Server
PORT=4000
NODE_ENV=development

# Database (matches docker-compose.yml defaults — update if you change those)
DATABASE_URL="postgresql://emv_admin:emv_dev_password@localhost:5432/b2b_emv?schema=public"

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Email (build step 8)
# EMAIL_TRANSPORT=console renders emails to the server console (default, safe with no SMTP
# creds). Set EMAIL_TRANSPORT=smtp to send for real once SMTP_* below are filled in.
EMAIL_TRANSPORT=console

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASS=replace_me
SMTP_FROM="Ease My Vacations <no-reply@example.com>"
