# dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# env
.env
.env.*
!.env.example
!backend/.env.example

# build output
frontend/dist/
backend/dist/

# node's compile cache and any other scratch output — never source, and it churns on every run,
# which is why 963 of these files are currently tracked and dirty the diff on every `git status`.
temp/

# prisma
backend/prisma/*.db

# generated files (quote PDFs, payment screenshots, visa document uploads)
backend/storage/
storage/

# logs
npm-debug.log*
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# docker
postgres-data/

# terraform: see infra/.gitignore — state, tfvars and plans are all handled there

# written by the ECS deploy workflow at runtime, from the live task definition
task-definition.json
